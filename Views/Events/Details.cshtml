@model RaceDay.Models.Event
@{ ViewData["Title"] = Model.EventName; }

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.EventName</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-dark text-white p-4 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">@Model.EventName</h2>
                    <span class="text-white-50"><i class="bi bi-geo-alt-fill me-1"></i> @Model.Location</span>
                </div>
                <div class="text-end">
                    <h3 class="text-warning fw-bold mb-0">@Model.DistanceKM <small class="fs-6 text-white-50">KM</small></h3>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 text-center">
                        <small class="text-muted d-block text-uppercase fw-bold mb-1">Date</small>
                        <span class="fw-medium"><i class="bi bi-calendar-event text-primary me-2"></i>@Model.EventDate.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 text-center">
                        <small class="text-muted d-block text-uppercase fw-bold mb-1">Type</small>
                        <span class="fw-medium"><i class="bi bi-tag-fill text-primary me-2"></i>@Model.EventType</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 text-center">
                        <small class="text-muted d-block text-uppercase fw-bold mb-1">Route</small>
                        <span class="fw-medium text-truncate d-block" title="@Model.RouteInfo"><i class="bi bi-map-fill text-primary me-2"></i>@(Model.RouteInfo ?? "TBC")</span>
                    </div>
                </div>
            </div>
            <p class="text-muted">@Model.Description</p>
        </div>
    </div>

    <h4 class="fw-bold mb-3">Available Categories</h4>
    <div class="table-responsive">
        <table class="table table-custom table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Distance</th>
                    <th>Entry Fee</th>
                    @if (User.IsInRole("Participant")) { <th class="text-end">Action</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories ?? new List<RaceDay.Models.Category>())
                {
                    <tr>
                        <td class="fw-medium">@category.CategoryName</td>
                        <td><span class="badge bg-secondary rounded-pill px-3">@category.DistanceKM km</span></td>
                        <td class="fw-bold text-success">R @category.EntryFee.ToString("F2")</td>
                        @if (User.IsInRole("Participant"))
                        {
                            <td class="text-end">
                                <form asp-controller="EnrolmentsUI" asp-action="Enrol" method="post" class="d-inline">
                                    <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                    <input type="hidden" name="eventId" value="@Model.EventID" />
                                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">Enrol Now</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>