@model IEnumerable<RaceDay.DTOs.EventDto>
@{ ViewData["Title"] = "Upcoming Events"; }

<div class="container mt-4">
    <!-- Hero Section -->
    <div class="hero-section shadow-lg">
        <div class="row align-items-center position-relative" style="z-index: 1;">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill fw-bold">Upcoming Races</span>
                <h1 class="display-4 fw-bold mb-3">Push Your Limits.</h1>
                <p class="lead text-white-50 mb-4">Discover, enroll, and conquer the best running, cycling, and walking events in the country.</p>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger shadow-sm border-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div> }
    @if (TempData["Success"] != null) { <div class="alert alert-success shadow-sm border-0"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div> }

    <div class="d-flex justify-content-between align-items-center mb-4 mt-5">
        <h3 class="fw-bold m-0">Browse Events</h3>
        @if (User.IsInRole("Organiser"))
        {
            <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i> Create Event</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm p-4 text-center">
            <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
            <h5>No events available right now.</h5>
            <p class="text-muted mb-0">Check back later for upcoming races!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card event-card shadow-sm h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="icon-box">
                                    @if(ev.EventType == "Cycle") { <i class="bi bi-bicycle text-primary"></i> }
                                    else if(ev.EventType == "Walk") { <i class="bi bi-person-walking text-success"></i> }
                                    else { <i class="bi bi-person-running text-danger"></i> }
                                </div>
                                <span class="badge bg-light text-dark border">@(ev.EventType ?? "General")</span>
                            </div>
                            
                            <h4 class="card-title fw-bold mb-1">@ev.EventName</h4>
                            <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @ev.Location</p>
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between text-muted small mb-4">
                                    <span><i class="bi bi-calendar-event me-1"></i> @ev.EventDate.ToString("dd MMM yyyy")</span>
                                    <span><i class="bi bi-signpost-split me-1"></i> @ev.DistanceKM km</span>
                                </div>
                                <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-outline-dark w-100 rounded-pill fw-medium">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>