@model RaceDay.Models.Event
@{ ViewData["Title"] = "Manage Event"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Manage: @Model.EventName</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to Events</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success shadow-sm border-0"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div> }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-dark text-white p-3 rounded-top-4">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Add Category</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="EventsUI" asp-action="AddCategory" method="post">
                        <input type="hidden" name="EventId" value="@Model.EventID" />
                        <div class="mb-3">
                            <label class="form-label fw-medium">Category Name</label>
                            <input type="text" name="CategoryName" class="form-control" placeholder="e.g., 10km Fun Run" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Distance (km)</label>
                            <input type="number" step="0.1" name="DistanceKM" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold mt-2">Add Category</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <h4 class="fw-bold mb-3">Enrolments & Results</h4>
            @foreach (var cat in Model.Categories ?? new List<RaceDay.Models.Category>())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-light p-3 border-0 rounded-top-4 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-trophy text-warning me-2"></i>@cat.CategoryName</h6>
                        <span class="badge bg-dark">@cat.DistanceKM km</span>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Participant</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (cat.Enrolments != null && cat.Enrolments.Any())
                                {
                                    @foreach (var enr in cat.Enrolments)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium"><i class="bi bi-person me-2 text-muted"></i>@enr.Participant?.FullName</td>
                                            <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">@enr.Status</span></td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="ResultsUI" asp-action="CaptureResult" asp-route-enrolmentId="@enr.EnrolmentID" asp-route-participantName="@enr.Participant?.FullName" class="btn btn-sm btn-outline-primary rounded-pill">Capture Result</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="3" class="text-center py-4 text-muted">No participants enrolled yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>