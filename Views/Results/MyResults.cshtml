@model IEnumerable<RaceDay.DTOs.MyResultDto>
@{ ViewData["Title"] = "My Results"; }

<h2 class="mb-4 mt-4">My Performance History</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no recorded results yet.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Event</th>
                <th>Category</th>
                <th>Finish Time</th>
                <th>Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.FinishTime</td>
                    <td><strong>@item.Position</strong></td>
                </tr>
            }
        </tbody>
    </table>
}